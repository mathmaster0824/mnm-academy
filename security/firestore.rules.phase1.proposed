rules_version = '2';
// ═════════════════════════════════════════════════════════════════════════════
// 1단계(Phase 1) 제안 규칙 — 배포하지 않았다. Emulator 테스트도 아직 실행하지 못했다.
// 계획서: docs/SECURITY_REMEDIATION_PLAN.md
//
// 목적: 학생(익명) 세션의 로그인 방식은 그대로 두고, "원장 권한"만 서버가 검증하도록 바꾼다.
//   · 원장 = Firebase Auth 이메일/비밀번호 계정(비밀번호를 Firebase 서버가 검증) + meta/directors 허용 목록의 uid
//   · 학생 세션(익명) = 원장이 아닌 모든 로그인 세션
//
// 1단계로 막을 수 있는 것:
//   · 원장 비밀번호 노출 (meta 는 원장 전용, 앱은 비밀번호를 Firestore 에 두지 않게 변경)
//   · 학생 세션의 원장 관리 데이터 수정(students, classes, courses, classRecords, weeklyPlans …)
//   · 월말 리포트·피드백·내신시험 등 원장 전용 데이터 읽기/쓰기
//   · 학생 세션의 원장 전용 상태값 조작(숙제 승인, STAD 승인/출석, 질문 답변, 주말학습 수동인정)
// 1단계로 막을 수 없는 것 (2단계 필요):
//   · 학생 A 세션이 학생 B 의 자료를 읽거나, B 의 이름으로 제출·질문을 쓰는 것
//     (학생 세션이 "누구인지" 서버가 모르기 때문 — students 문서의 code 도 전 학생이 읽을 수 있음)
//
// 배포 순서 주의: 이 규칙은 앱 코드 변경(원장 Firebase Auth 로그인, meta/settings 비밀번호 제거,
//   익명 세션이 meta 를 읽지 않도록 변경)이 먼저 운영에 반영된 뒤에만 배포할 수 있다.
//   먼저 배포하면 모든 접속자의 로딩이 막힌다(앱이 로그인 전에 meta/settings 를 읽기 때문).
// ═════════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 비밀번호 로그인(Firebase 서버 검증)이고, 허용 목록 문서(meta/directors.uids)에 uid 가 있는 세션.
    // 익명 세션·custom claim 위조·클라이언트가 보낸 값은 영향이 없다.
    function isDirector() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/meta/directors)
        && request.auth.uid in get(/databases/$(database)/documents/meta/directors).data.uids;
    }

    // ── A. 원장 전용 (읽기·쓰기) ───────────────────────────────────────────
    match /meta/{docId}                 { allow read, write: if isDirector(); }
    match /monthlyReports/{document=**} { allow read, write: if isDirector(); }
    match /feedbacks/{docId}            { allow read, write: if isDirector(); }
    match /solutionPhotos/{docId}       { allow read, write: if isDirector(); }
    match /focusHistory/{docId}         { allow read, write: if isDirector(); }

    // ── B. 문제저장소 연동 컬렉션 — 현행 유지(로그인 전체 허용) ───────────────
    // 학생이 질문을 올리면 학생 세션이 syncQuestionToProblemRepo → problemSources/problemDrafts/problems 에 쓴다.
    // 문제저장소는 이번 범위 밖이라 동작을 바꾸지 않는다. problemKeys(정답키)도 같은 경로에 있어 열려 있다.
    // → 문제저장소 작업에서 "질문→저장소 연결을 서버(Cloud Functions) 처리로 이전"한 뒤 원장 전용으로 닫는다.
    match /problemSources/{docId} { allow read, write: if signedIn(); }
    match /problemDrafts/{docId}  { allow read, write: if signedIn(); }
    match /problems/{docId}       { allow read, write: if signedIn(); }
    match /problemKeys/{docId}    { allow read, write: if signedIn(); }

    // ── C. 로그인 세션 읽기 / 원장만 쓰기 ──────────────────────────────────
    match /students/{docId}       { allow read: if signedIn(); allow write: if isDirector(); }
    match /classes/{docId}        { allow read: if signedIn(); allow write: if isDirector(); }
    match /courses/{docId}        { allow read: if signedIn(); allow write: if isDirector(); }
    match /classRecords/{docId}   { allow read: if signedIn(); allow write: if isDirector(); }
    match /weeklyPlans/{docId}    { allow read: if signedIn(); allow write: if isDirector(); }
    match /fridaySupp/{docId}     { allow read: if signedIn(); allow write: if isDirector(); }
    match /weekendClasses/{docId} { allow read: if signedIn(); allow write: if isDirector(); }
    match /weekendSettings/{docId}{ allow read: if signedIn(); allow write: if isDirector(); }
    match /stadSettings/{docId}   { allow read: if signedIn(); allow write: if isDirector(); }
    match /practiceProgress/{docId}{ allow read: if signedIn(); allow write: if isDirector(); }
    match /kmm/{docId}            { allow read: if signedIn(); allow write: if isDirector(); }
    match /schoolScores/{docId}   { allow read: if signedIn(); allow write: if isDirector(); }
    match /schoolExams/{docId}    { allow read: if signedIn(); allow write: if isDirector(); }
    match /videos/{docId}         { allow read: if signedIn(); allow write: if isDirector(); }
    match /assignments/{docId}    { allow read: if signedIn(); allow write: if isDirector(); }

    // ── D. 학생 세션이 쓰는 컬렉션 — 원장 전용 상태값만 보호 ─────────────────
    // 숙제 제출: 학생은 '제출완료' 상태의 제출과 확인 표시(commentSeen)만. 승인/보완/불합격·코멘트는 원장만.
    // 재제출은 문서 전체를 덮어쓰므로 teacherComment 는 "없애거나 그대로 두는 것"만 허용하고 새 값은 쓸 수 없다.
    // 알려진 한계: reviewCount·reviewReason·reviewedAt 은 앱이 값을 정해 보내므로 규칙만으로는 학생 조작을 막지 못한다.
    match /submissions/{docId} {
      allow read: if signedIn();
      allow create: if isDirector()
                    || (signedIn() && request.resource.data.status == '제출완료'
                        && !('teacherComment' in request.resource.data));
      allow update: if isDirector()
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentSeen'])
                        && request.resource.data.get('commentSeen', false) == true)
                    || (signedIn() && request.resource.data.status == '제출완료'
                        && resource.data.get('status', '') != '최종불합격'
                        && (!('teacherComment' in request.resource.data)
                            || request.resource.data.teacherComment == resource.data.get('teacherComment', null)));
      allow delete: if isDirector();
    }

    // 공부시간 타이머: 학생이 만들고 지운다.
    match /timerState/{docId} { allow read, write: if signedIn(); }

    // 주말학습 인증: 학생은 사진 제출/삭제, 원장 수동인정(manual)은 원장만 설정.
    match /weekendSubmissions/{docId} {
      allow read: if signedIn();
      allow create: if isDirector()
                    || (signedIn() && request.resource.data.get('manual', false) == false);
      allow update: if isDirector()
                    || (signedIn() && request.resource.data.get('manual', false) == resource.data.get('manual', false));
      allow delete: if signedIn();
    }

    // STAD 신청: 학생은 '대기(pending)' 신청만. 승인·입금확인·삭제는 원장만.
    match /stadApplications/{docId} {
      allow read: if signedIn();
      allow create: if isDirector()
                    || (signedIn() && request.resource.data.status == 'pending'
                        && request.resource.data.get('paymentConfirmed', false) == false);
      allow update: if isDirector()
                    || (signedIn() && resource.data.get('status', '') in ['pending', 'rejected']
                        && request.resource.data.status == 'pending'
                        && request.resource.data.get('paymentConfirmed', false) == false);
      allow delete: if isDirector();
    }

    // STAD 일일 기록: 학생은 할 일/정산 입력, 출석(attended)은 원장만.
    match /stadDaily/{docId} {
      allow read: if signedIn();
      allow create: if isDirector()
                    || (signedIn() && request.resource.data.get('attended', false) == false);
      allow update: if isDirector()
                    || (signedIn() && request.resource.data.get('attended', null) == resource.data.get('attended', null));
      allow delete: if isDirector();
    }

    // 질문: 학생은 '대기' 질문 작성/수정만. 답변·상태 '답변완료'는 원장만.
    match /questions/{docId} {
      allow read: if signedIn();
      allow create: if isDirector()
                    || (signedIn() && request.resource.data.status == '대기'
                        && request.resource.data.get('answerText', '') == ''
                        && request.resource.data.get('answerPhotos', []) == []);
      allow update: if isDirector()
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'photos', 'status'])
                        && request.resource.data.status == '대기');
      allow delete: if isDirector();
    }

    // 답지 제출: 학생은 최초 제출 1회, 틀린 이유 선택, 학습완료 표시만. 채점/검토 결과는 원장만.
    match /answerSubmissions/{docId} {
      allow read: if signedIn();
      allow create: if isDirector() || signedIn();
      allow update: if isDirector()
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wrongReasons', 'learningCompletedAt']));
      allow delete: if isDirector();
    }

    // ── E. 그 밖의 모든 경로: 원장만 ──────────────────────────────────────
    // 위에 적지 않은 컬렉션은 학생(익명) 세션에게 기본 거부다. 원장은 모두 허용해, 빠진 컬렉션 때문에
    // 원장 기능(예: 전체 백업이 읽는 settings/main)이 깨지지 않게 한다. 허용 조건은 OR 로 결합되므로
    // 위의 학생 대상 제한을 풀어주지 않는다(isDirector 가 참일 때만 추가 허용).
    match /{document=**} {
      allow read, write: if isDirector();
    }
  }
}
