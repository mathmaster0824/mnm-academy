rules_version = '2';
// ═════════════════════════════════════════════════════════════════════════════
// 2단계(Phase 2) 목표 규칙 — 배포하지 않았다. GitHub Actions Emulator 테스트 통과(2026-10-26).
// 계획서: docs/SECURITY_REMEDIATION_PLAN.md
//
// 전제(앱·서버 변경이 먼저 운영에 반영돼야 한다 — 이 규칙만 배포하면 학생 앱이 전부 멈춘다):
//   1) 학생 로그인: 학생 코드 확인을 서버(Cloud Functions)가 하고, 성공하면 custom token 을 발급한다.
//      토큰 claim: role='student', studentId=<students 문서 ID>.  (익명 로그인은 더 이상 쓰지 않는다)
//   2) 원장 로그인: 1단계와 동일(Firebase Auth 이메일/비밀번호 + 규칙 파일에 적은 원장 UID).
//   3) 학생 앱은 collection 범위(prefix) 쿼리 대신 "내 문서 ID 정확 조회"를 쓴다
//      (규칙은 문서 ID 범위 쿼리를 증명하지 못해 list 를 허용할 수 없다).
//   4) 반 단위 문서(classRecords/weeklyPlans/fridaySupp)는 한 문서에 같은 반 전체 학생 데이터가 들어 있어
//      학생별 권한을 줄 수 없다. → 서버(Cloud Functions)가 학생별 사본(studentRecords/studentPlans/
//      studentFridaySupp)을 만들고, 학생은 자기 사본만 읽는다. 원본은 원장 전용.
//   5) 질문→문제저장소 연결(syncQuestionToProblemRepo)은 서버로 옮겨 학생이 problems* 를 직접 쓰지 않게 한다.
// ═════════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 원장 UID 는 이 규칙 파일에 직접 적는다(Firestore 문서의 허용 목록을 쓰지 않는다).
    // 규칙은 Firebase 콘솔에서만 고칠 수 있어, 공개 클라이언트가 원장 목록을 바꿀 수 없다.
    // UID 는 비밀값이 아니다(비밀번호·API 비밀키를 적는 곳이 아님). 게시 전에 아래 자리표시자를
    // 콘솔 Authentication → Users 에서 확인한 "원장 계정의 사용자 UID" 로 바꾼다. 여러 명이면 쉼표로 추가한다.
    // 자리표시자 그대로 게시하면 아무도 원장이 되지 못한다(앱 로딩·학생 기능은 유지, 원장 전용 기능만 막힘).
    // 원장을 바꾸거나 추가하려면 이 값을 고쳐 규칙을 **다시 게시**해야 한다.
    function directorUids() { return ['REPLACE_WITH_DIRECTOR_UID']; }

    // 비밀번호 로그인(Firebase 서버 검증)이고, uid 가 위 목록에 있는 세션.
    // 익명 세션·custom claim 위조·클라이언트가 보낸 값·Firestore 문서 내용은 영향이 없다.
    function isDirector() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid in directorUids();
    }

    // 서버(Admin SDK)가 발급한 custom token 만 'custom' 공급자를 가진다. 클라이언트는 claim 을 만들 수 없다.
    function isStudent() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.role == 'student'
        && request.auth.token.studentId is string
        && request.auth.uid == request.auth.token.studentId;
    }
    function me() { return request.auth.token.studentId; }

    // 문서 ID 가 '<내 학생ID>_…' 형태인가('학생ID_날짜', '학생ID_월', '학생ID_반ID_날짜' 모두 해당).
    // 현재 앱 신규 ID 생성기는 'stu_' + 11자(난수 7자 + 시각 4자)를 만든다. 다만 기존 운영 ID 전체가
    // 이 형식인지는 확인하지 않았다. 다른 학생 ID가 내 ID + '_' 로 시작하면 접두어 권한이 겹칠 수 있으므로
    // 실제 규칙 적용 전 운영 학생 ID 목록에서 형식과 접두어 충돌을 확인해야 한다.
    function ownDocId(docId) {
      return isStudent()
        && docId.size() > me().size() + 1
        && docId[0:me().size() + 1] == me() + '_';
    }
    // 문서 ID 가 '…_<내 학생ID>' 로 끝나는가 (answerSubmissions: '<과제ID>_<학생ID>')
    function ownDocIdSuffix(docId) {
      return isStudent()
        && docId.size() > me().size() + 1
        && docId[docId.size() - me().size() - 1:docId.size()] == '_' + me();
    }

    // ── A. 원장 전용 ────────────────────────────────────────────────────────
    match /meta/{docId}                 { allow read, write: if isDirector(); }
    match /monthlyReports/{document=**} { allow read, write: if isDirector(); }
    // Growth survey payloads are callable-only for students; Admin SDK endpoints scope each request.
    match /growthSurveys/{docId}          { allow read, write: if isDirector(); }
    match /_system_login_throttle/{docId} { allow read, write: if false; }
    match /feedbacks/{docId}            { allow read, write: if isDirector(); }
    match /solutionPhotos/{docId}       { allow read, write: if isDirector(); }
    match /focusHistory/{docId}         { allow read, write: if isDirector(); }
    match /classRecords/{docId}         { allow read, write: if isDirector(); }
    match /weeklyPlans/{docId}          { allow read, write: if isDirector(); }
    match /fridaySupp/{docId}           { allow read, write: if isDirector(); }
    // 문제저장소: 학생 직접 접근 금지(서버 연결 이전 후). 정답키는 원장·서버만.
    match /problemSources/{docId}       { allow read, write: if isDirector(); }
    match /problemDrafts/{docId}        { allow read, write: if isDirector(); }
    match /problems/{docId}             { allow read, write: if isDirector(); }
    match /problemKeys/{docId}          { allow read, write: if isDirector(); }

    // ── B. 학생별 사본(서버가 Admin SDK 로만 쓴다) ─────────────────────────────
    match /studentRecords/{docId}    { allow read: if isDirector() || ownDocId(docId); allow write: if isDirector(); }
    match /studentPlans/{docId}      { allow read: if isDirector() || ownDocId(docId); allow write: if isDirector(); }
    match /studentFridaySupp/{docId} { allow read: if isDirector() || ownDocId(docId); allow write: if isDirector(); }

    // ── C. 학생 본인 정보 / 소속 반 ──────────────────────────────────────────
    // students 문서에는 원장 메모(memo)·경고(warnings)·성실도(diligence)가 같이 들어 있다.
    // 학생이 이를 볼 수 있어도 되는지는 원장 결정 사항 → 필요하면 필드를 별도 문서로 분리(계획서 §6).
    match /students/{docId} {
      allow get: if isStudent() && docId == me();
      allow list: if isDirector();
      allow write: if isDirector();
    }
    match /classes/{docId} {
      allow get, list: if isStudent() && me() in resource.data.studentIds;
      allow write: if isDirector();
    }
    match /weekendClasses/{docId} {
      allow get, list: if isStudent() && me() in resource.data.studentIds;
      allow write: if isDirector();
    }
    match /courses/{docId}         { allow read: if isStudent(); allow write: if isDirector(); }
    match /weekendSettings/{docId} { allow read: if isStudent(); allow write: if isDirector(); }
    match /stadSettings/{docId}    { allow read: if isStudent(); allow write: if isDirector(); }
    match /schoolExams/{docId}     { allow read: if isStudent(); allow write: if isDirector(); }
    match /videos/{docId}          { allow read: if isStudent(); allow write: if isDirector(); }

    // 학생 본인 문서만 읽고, 쓰기는 원장만
    match /practiceProgress/{docId} {
      allow get: if isStudent() && docId == me();
      allow list: if isDirector();
      allow write: if isDirector();
    }
    match /kmm/{docId} {
      allow get, list: if isStudent() && resource.data.studentId == me();
      allow write: if isDirector();
    }
    match /schoolScores/{docId} {
      allow get, list: if isStudent() && resource.data.studentId == me();
      allow write: if isDirector();
    }
    match /assignments/{docId} {
      allow get, list: if isStudent() && me() in resource.data.studentIds;
      allow write: if isDirector();
    }

    // ── D. 학생이 쓰는 컬렉션 — 본인 문서만 ──────────────────────────────────
    match /submissions/{docId} {
      allow get: if isDirector() || ownDocId(docId);
      allow list: if isDirector();
      allow create: if ownDocId(docId)
                    && request.resource.data.studentId == me()
                    && request.resource.data.status == '제출완료'
                    && !('teacherComment' in request.resource.data);
      allow update: if ownDocId(docId)
                    && request.resource.data.studentId == me()
                    && (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentSeen'])
                           && request.resource.data.get('commentSeen', false) == true)
                      || (request.resource.data.status == '제출완료' && resource.data.get('status', '') != '최종불합격'
                          && (!('teacherComment' in request.resource.data)
                              || request.resource.data.teacherComment == resource.data.get('teacherComment', null)))
                       );
      allow write: if isDirector();
    }
    match /timerState/{docId} {
      allow read, write: if isDirector() || ownDocId(docId);
    }
    match /weekendSubmissions/{docId} {
      allow get: if isDirector() || ownDocId(docId);
      allow list: if isDirector();
      allow create: if ownDocId(docId)
                    && request.resource.data.studentId == me()
                    && request.resource.data.get('manual', false) == false;
      allow update: if ownDocId(docId)
                    && request.resource.data.studentId == me()
                    && request.resource.data.get('manual', false) == resource.data.get('manual', false);
      allow delete: if ownDocId(docId);
      allow write: if isDirector();
    }
    match /stadApplications/{docId} {
      allow get: if isDirector() || ownDocId(docId);
      allow list: if isDirector();
      allow create: if ownDocId(docId)
                    && request.resource.data.studentId == me()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('paymentConfirmed', false) == false;
      allow update: if ownDocId(docId)
                    && resource.data.get('status', '') in ['pending', 'rejected']
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('paymentConfirmed', false) == false;
      allow write: if isDirector();
    }
    match /stadDaily/{docId} {
      allow get: if isDirector() || ownDocId(docId);
      allow list: if isDirector();
      allow create: if ownDocId(docId)
                    && request.resource.data.studentId == me()
                    && request.resource.data.get('attended', false) == false;
      allow update: if ownDocId(docId)
                    && request.resource.data.get('attended', null) == resource.data.get('attended', null);
      allow write: if isDirector();
    }
    match /questions/{docId} {
      allow get, list: if isStudent() && resource.data.studentId == me();
      allow create: if isStudent()
                    && request.resource.data.studentId == me()
                    && request.resource.data.status == '대기'
                    && request.resource.data.get('answerText', '') == ''
                    && request.resource.data.get('answerPhotos', []) == [];
      allow update: if isStudent() && resource.data.studentId == me()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'photos', 'status'])
                    && request.resource.data.status == '대기';
      allow write: if isDirector();
    }
    match /answerSubmissions/{docId} {
      allow get, list: if isStudent() && resource.data.studentId == me();
      allow create: if ownDocIdSuffix(docId) && request.resource.data.studentId == me();
      allow update: if isStudent() && resource.data.studentId == me()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wrongReasons', 'learningCompletedAt']);
      allow write: if isDirector();
    }

    // ── E. 그 밖의 모든 경로: 원장만 (학생·익명·비로그인은 기본 거부) ─────────────
    match /{document=**} {
      allow read, write: if isDirector();
    }
  }
}
