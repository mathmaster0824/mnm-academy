rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
// ─────────────────────────────────────────────────────────────────────────────
// 기준선(baseline) — 2026-10-19 Firebase 콘솔 규칙 탭 화면에서 원장이 직접 확인한 현재 배포 규칙(2026-08-19 15:59 게시).
