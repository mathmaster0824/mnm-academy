rules_version = '2';

// M&m 수학훈련소 Firestore 보안 규칙 (1단계)
// - 원장: Firebase 이메일 로그인 계정(아래 UID)만 모든 데이터를 읽고 쓴다.
// - 학생: 익명 로그인 후 학생 코드로 studentSessions/{내 uid}를 만든 사람만 운영 데이터를 쓴다.
// - 그 외(로그인 화면만 연 사람): 학생 코드 문서 한 건 조회와 자기 세션 만들기만 가능하다.
// 이 파일은 Firebase 콘솔 › Firestore Database › 규칙 에 붙여넣어 게시한다.
// (index.html의 DIRECTOR_UID와 같은 값이어야 한다.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isDirector() {
      return signedIn() && request.auth.uid == 'bcCt2VfFy2dyS786zXGpH0fuHIi2';
    }
    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/studentSessions/$(request.auth.uid));
    }
    function codeDoc(code) {
      return /databases/$(database)/documents/studentCodes/$(code);
    }

    // 학생 코드 → 학생 ID. 로그인한 사람은 코드 하나를 알 때만 그 문서를 읽을 수 있다(목록 조회 불가).
    match /studentCodes/{code} {
      allow get: if signedIn();
      allow list, write: if isDirector();
    }

    // 학생 세션: 자기 uid 문서만, 실제 코드와 학생 ID가 맞을 때만 만들 수 있다.
    match /studentSessions/{uid} {
      allow get, delete: if isDirector() || (signedIn() && request.auth.uid == uid);
      allow list: if isDirector();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId', 'code', 'at'])
        && request.resource.data.code is string
        && exists(codeDoc(request.resource.data.code))
        && get(codeDoc(request.resource.data.code)).data.studentId == request.resource.data.studentId
        && get(codeDoc(request.resource.data.code)).data.status != 'withdrawn';
    }

    // 운영 설정: 원장 전용
    match /meta/{doc} {
      allow read, write: if isDirector();
    }

    // 나머지 운영 데이터: 원장 또는 로그인한 학생 (2단계에서 학생은 자기 기록만으로 좁힌다)
    match /{coll}/{rest=**} {
      allow read, write: if !(coll in ['studentCodes', 'studentSessions', 'meta'])
        && (isDirector() || isStudent());
    }
  }
}
