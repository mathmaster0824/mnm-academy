rules_version = '2';

// M&m 수학훈련소 Firestore 보안 규칙 (3단계: 반 출석부는 원장 전용, 학생은 자기 사본만)
// - 원장: Firebase 이메일 로그인 계정(아래 UID)만 모든 데이터를 읽고 쓴다.
// - 학생: 익명 로그인 → 학생 코드 + 비밀번호 4자리로 studentSessions/{내 uid}를 만든 사람.
//         세션의 비밀번호가 studentPins와 맞고, 코드가 퇴원 처리되지 않았을 때만 학생으로 인정한다.
//         학생은 공용 자료는 읽기만, 학생별 기록은 studentId가 본인인 것만 읽고 쓴다.
// - 그 외(로그인 화면만 연 사람): 코드 한 건 조회, 첫 비밀번호 만들기, 자기 세션 만들기만 가능.
// 이 파일은 Firebase 콘솔 › Firestore Database › 규칙 에 붙여넣어 게시한다.
// (index.html의 DIRECTOR_UID와 같은 값이어야 한다.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isDirector() {
      return signedIn() && request.auth.uid == 'bcCt2VfFy2dyS786zXGpH0fuHIi2';
    }
    function docPath(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }
    function sess() { return get(docPath('studentSessions', request.auth.uid)).data; }
    function isStudent() {
      return signedIn()
        && exists(docPath('studentSessions', request.auth.uid))
        && ('pin' in sess())
        && exists(docPath('studentPins', sess().code))
        && get(docPath('studentPins', sess().code)).data.pin == sess().pin
        && get(docPath('studentCodes', sess().code)).data.studentId == sess().studentId
        && get(docPath('studentCodes', sess().code)).data.status != 'withdrawn';
    }
    function me() { return sess().studentId; }
    // 학생별 기록: 기존 문서도, 새로 쓰는 내용도 studentId가 본인이어야 한다.
    function ownsExisting() { return resource == null || resource.data.studentId == me(); }
    function ownsNew() { return request.resource.data.studentId == me(); }

    // ---------- 로그인용 ----------
    match /studentCodes/{code} {
      allow get: if signedIn();
      allow list, write: if isDirector();
    }
    // 학생 비밀번호: 학생은 읽을 수 없다. 아직 없을 때 한 번만 만들 수 있고, 초기화(삭제)는 원장만.
    match /studentPins/{code} {
      allow read, update, delete: if isDirector();
      allow create: if isDirector() || (signedIn()
        && request.resource.data.keys().hasOnly(['pin', 'setAt'])
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$')
        && exists(docPath('studentCodes', code))
        && get(docPath('studentCodes', code)).data.status != 'withdrawn');
    }
    // 학생 세션: 자기 uid 문서만, 코드·학생·비밀번호가 모두 맞을 때만 만들 수 있다.
    match /studentSessions/{uid} {
      allow get, delete: if isDirector() || (signedIn() && request.auth.uid == uid);
      allow list: if isDirector();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId', 'code', 'pin', 'at'])
        && request.resource.data.code is string
        && exists(docPath('studentCodes', request.resource.data.code))
        && get(docPath('studentCodes', request.resource.data.code)).data.studentId == request.resource.data.studentId
        && get(docPath('studentCodes', request.resource.data.code)).data.status != 'withdrawn'
        && exists(docPath('studentPins', request.resource.data.code))
        && get(docPath('studentPins', request.resource.data.code)).data.pin == request.resource.data.pin;
    }

    // ---------- 원장 전용 ----------
    match /meta/{d} { allow read, write: if isDirector(); }

    // ---------- 학생: 본인 정보만 ----------
    match /students/{id} {
      allow get: if isDirector() || (isStudent() && id == me());
      allow list, write: if isDirector();
    }
    match /practiceProgress/{id} {
      allow get: if isDirector() || (isStudent() && id == me());
      allow list, write: if isDirector();
    }

    // ---------- 공용 자료: 학생은 읽기만 ----------
    match /classes/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /courses/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /videos/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /schoolExams/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /solutionPhotos/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /weekendSettings/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /weekendClasses/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /stadSettings/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    match /weeklyPlans/{d} { allow read: if isDirector() || isStudent(); allow write: if isDirector(); }
    // 금요 보강 기록: 학생 화면에서 쓰지 않으므로 원장 전용
    match /fridaySupp/{d} { allow read, write: if isDirector(); }
    // 반 수업 기록(반 출석부): 한 문서에 반 전원의 출결·진도·점수·특이사항이 있으므로 학생은 읽지 못한다.
    // 학생은 자기 칸의 영상 과제 체크(videoAssignments)만 바꿀 수 있다.
    match /classRecords/{d} {
      allow read, create, delete: if isDirector();
      allow update: if isDirector() || (isStudent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([me()])
        && request.resource.data[me()].diff(resource.data[me()]).affectedKeys().hasOnly(['videoAssignments']));
    }
    // 학생별 수업 기록 사본: 원장 화면이 만들고, 학생은 자기 것만 읽는다. 영상 과제 체크만 바꿀 수 있다.
    match /studentRecords/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, delete: if isDirector();
      allow update: if isDirector() || (isStudent()
        && resource.data.studentId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rec'])
        && request.resource.data.rec.diff(resource.data.rec).affectedKeys().hasOnly(['videoAssignments']));
    }
    // 답지 과제: 학생은 자기에게 낸 과제만 읽는다.
    match /assignments/{d} {
      allow read: if isDirector() || (isStudent() && me() in resource.data.studentIds);
      allow write: if isDirector();
    }

    // ---------- 학생별 기록: 본인 것만 ----------
    // 학생이 읽기만 하는 것
    match /schoolScores/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow write: if isDirector();
    }
    match /kmm/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow write: if isDirector();
    }
    // 학생이 직접 올리고 고치는 것
    match /submissions/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, update: if isDirector() || (isStudent() && ownsExisting() && ownsNew());
      allow delete: if isDirector();
    }
    match /answerSubmissions/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, update: if isDirector() || (isStudent() && ownsExisting() && ownsNew());
      allow delete: if isDirector();
    }
    match /questions/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, update: if isDirector() || (isStudent() && ownsExisting() && ownsNew());
      allow delete: if isDirector();
    }
    match /stadApplications/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, update: if isDirector() || (isStudent() && ownsExisting() && ownsNew());
      allow delete: if isDirector();
    }
    match /stadDaily/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, update: if isDirector() || (isStudent() && ownsExisting() && ownsNew());
      allow delete: if isDirector();
    }
    match /weekendSubmissions/{d} {
      allow get: if isDirector() || (isStudent() && ownsExisting());
      allow list: if isDirector() || (isStudent() && resource.data.studentId == me());
      allow create, update: if isDirector() || (isStudent() && ownsExisting() && ownsNew());
      allow delete: if isDirector() || (isStudent() && resource.data.studentId == me());
    }

    // ---------- 그 밖의 모든 데이터: 원장만 ----------
    // (월말 리포트, 피드백, 집중관리, 문제저장소, 정답키, 문제 원본, 타이머 기록 등)
    match /{coll}/{rest=**} {
      allow read, write: if isDirector();
    }
  }
}
